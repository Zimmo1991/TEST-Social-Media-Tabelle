# Lokaler Webserver
HOST=127.0.0.1
PORT=8765
NODE_ENV=development

# Beim ersten Produktionsstart kann der Hauptadmin direkt serverseitig angelegt werden.
# Das Passwort muss mindestens 10 Zeichen lang sein. Diese Werte niemals in Git einchecken.
MAIN_ADMIN_NAME=
MAIN_ADMIN_EMAIL=
MAIN_ADMIN_PASSWORD=

# Nach einer Veröffentlichung muss Meta die Medien über diese öffentliche HTTPS-Adresse abrufen können.
# Lokal kann dafür später z. B. eine sichere Tunnel-Adresse verwendet werden.
PUBLIC_BASE_URL=

# Passwort-zurücksetzen-E-Mails über das Postfach deiner Domain versenden.
# Die exakten SMTP-Werte findest du bei deinem E-Mail-Anbieter.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Planyoursocials <deine-email@deine-domain.tld>

# Nur für lokale automatische Tests; versendet keine echte E-Mail.
MAIL_DRY_RUN=false

# Meta App / Instagram API with Instagram Login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8765/api/instagram/callback
INSTAGRAM_API_VERSION=v24.0

# Genau 32 zufällige Bytes als Base64. Beispiel erzeugen:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Nur für einen lokalen Test ohne echte Veröffentlichung verwenden.
INSTAGRAM_DRY_RUN=false

# Optionaler technischer Notfallzugriff. Die Weboberfläche verwendet die persönliche Anmeldung.
APP_ADMIN_KEY=

# Automatische Übersetzung Deutsch -> Italienisch/Englisch über DeepL.
# Kostenlose DeepL-API-Schlüssel mit :fx verwenden automatisch api-free.deepl.com.
DEEPL_API_KEY=
# Optional für einen abweichenden DeepL-Endpunkt:
DEEPL_API_URL=

# Nur für lokale automatisierte Tests; erzeugt keine echte Übersetzung.
TRANSLATION_DRY_RUN=false

# KI-Vorbereitungsagent: Schlüssel und Modell bleiben ausschließlich im Backend.
# Der Schlüssel darf niemals in script.js, index.html oder Git eingetragen werden.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Nur für lokale automatisierte Tests; analysiert keine echten Bilder und ruft keine KI auf.
AI_AGENT_DRY_RUN=false

# Nur für den Betrieb auf ALL-INKL: Kundenordner liegen direkt unter diesem
# nicht öffentlich erreichbaren Serverordner.
AI_IMAGE_ROOT=

# Nur für den geschützten ALL-INKL-Cronjob (mindestens 32 zufällige Zeichen).
CRON_SECRET=
