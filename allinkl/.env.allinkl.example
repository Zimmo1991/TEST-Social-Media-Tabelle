# Diese Datei auf dem Webspace als .env im Planyoursocials-Hauptordner speichern,
# NICHT im öffentlich erreichbaren Unterordner allinkl/public.
NODE_ENV=production
PUBLIC_BASE_URL=https://DEINE-DOMAIN.TLD

# Nur für eine neue, leere Datenbank. Bei Übernahme der bestehenden Datenbank
# bleibt das vorhandene Hauptadmin-Konto mitsamt Passwort bestehen.
MAIN_ADMIN_NAME=
MAIN_ADMIN_EMAIL=
MAIN_ADMIN_PASSWORD=

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Planyoursocials <deine-email@deine-domain.tld>

DEEPL_API_KEY=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://DEINE-DOMAIN.TLD/api/instagram/callback
INSTAGRAM_API_VERSION=v24.0
TOKEN_ENCRYPTION_KEY=
INSTAGRAM_DRY_RUN=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_AGENT_DRY_RUN=false
AI_IMAGE_ROOT=

# Mindestens 32 zufällige Zeichen; nur im KAS-Cronjob und hier verwenden.
CRON_SECRET=
